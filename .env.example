# Скопировать в .env и задать пароль. Файл .env в git не попадает.
#
# У секретов нет значений по умолчанию в коде (инвариант I10): пустая
# переменная — служба не стартует и говорит, чего именно не хватает.

APP_ENV=dev
LOG_LEVEL=debug

POSTGRES_USER=inventory
POSTGRES_PASSWORD=
POSTGRES_DB=inventory

# Адрес, на котором публикуются служебные порты.
#
# 127.0.0.1 — то есть только с этой машины. База, лента, её админский API,
# Prometheus и Grafana в разработке пароля не спрашивают, и на 0.0.0.0 они
# предъявлялись всей сети завода: сканирование с чужого хоста получало
# список тем ленты и панели Grafana без единого пароля.
#
# Порт агентов (HTTP_EXPOSED_PORT) под это не попадает — его работа как раз
# в том, чтобы принимать соединения с других машин.
#
# 0.0.0.0 — если нужно открыть экран с телефона или подключить агент с
# соседней машины. Осознанно и на время работы, не насовсем.
BIND_ADDR=127.0.0.1

# Порты наружу. Смещены от стандартных, чтобы не столкнуться с уже
# запущенными на этой машине Postgres и учётной системой.
POSTGRES_EXPOSED_PORT=5434
KAFKA_EXPOSED_PORT=19092
REDPANDA_ADMIN_PORT=9644
HTTP_EXPOSED_PORT=8090

# Молчащие машины. Порог заметно больше периода сбора: машина, выключенная на
# ночь, не должна попадать в список каждое утро.
SILENCE_THRESHOLD=168h
SILENCE_INTERVAL=1h

# Административный вход: постановка заданий не агентом, а другой системой.
#
# Нужен для кнопки «Обновить сейчас» в чужом интерфейсе. Пустое значение
# означает, что таких маршрутов НЕТ вовсе — открытый вход к заданиям всего
# парка не должен получаться из-за незаданной переменной.
ADMIN_TOKEN=

# Сроки хранения. Пустые значения означают «как в программе»: снимки месяц,
# опубликованные сообщения неделя, задания месяц.
RETENTION_SNAPSHOTS=
RETENTION_OUTBOX=
RETENTION_COMMANDS=
RETENTION_INTERVAL=

# Сколько регистраций в минуту принимать с одного адреса. Пусто — 600.
# Меньше шестидесяти ломает раскатку групповой политикой: см. DefaultEnrollBurst.
ENROLL_BURST=

# Порты наблюдения (профиль metrics).
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
