# Скопируйте в .env и поправьте значения

POSTGRES_USER=xml
POSTGRES_PASSWORD=смените-пароль-БД
POSTGRES_DB=xml_parser

# Ключ подписи JWT. Обязательно задайте свой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Если оставить пустым, при старте сгенерируется временный ключ
# и после каждого перезапуска все пользователи будут разлогинены.
SECRET_KEY=

# Учётка администратора создаётся один раз при первом старте пустой базы.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=смените-этот-пароль

# Swagger на /docs. На проде рекомендуется false.
ENABLE_DOCS=true

# Ограничения
MAX_UPLOAD_MB=30
LOGIN_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# Сторонние origin'ы для браузерных запросов к API (обычно не нужны — фронт
# ходит через тот же адрес). Формат JSON: ["https://example.com"]
# CORS_ORIGINS=[]

# Порты для разработки (docker-compose.yml):
#   API_PORT — API наружу, WEB_PORT — интерфейс
API_PORT=8000
WEB_PORT=8080

# Порты для сервера (docker-compose.prod.yml): наружу смотрит только nginx,
# 80 редиректит на 443. API и база остаются внутри сети контейнеров.
HTTP_PORT=80
HTTPS_PORT=443
