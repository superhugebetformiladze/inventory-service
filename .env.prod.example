# Рабочее окружение службы. Скопировать в .env.prod и заполнить:
#
#   cp .env.prod.example .env.prod
#
# .env.prod в git не попадает. У секретов нет значений по умолчанию ни здесь,
# ни в коде: незаданный секрет — служба не стартует и говорит, чего не хватает.
#
# Сгенерировать секрет:
#   openssl rand -base64 32

# Версия образа. Меняется при каждом обновлении — по ней видно, что стоит на
# сервере, и можно вернуться на прежнюю: make prod-up APP_VERSION=2026-09-14.
APP_VERSION=latest
LOG_LEVEL=info

# --- База ---
POSTGRES_USER=inventory
POSTGRES_PASSWORD=
POSTGRES_DB=inventory

# --- Порт, на который приходят агенты ---
# Этот адрес записывается в server.txt пакета раскатки: http://<сервер>:8090
HTTP_PORT=8090

# --- Кнопка «Обновить сейчас» в учётной системе ---
# Тот же ключ записывается в INVENTORY_ADMIN_TOKEN учётной системы.
ADMIN_TOKEN=

# --- Общая сеть с учётной системой ---
# То же имя — в INVENTORY_FEED_NETWORK учётной системы.
FEED_NETWORK=inventory-feed

# --- Молчащие машины ---
# Порог заметно больше периода сбора: машина, выключенная на выходные, не
# должна попадать в список каждый понедельник.
SILENCE_THRESHOLD=168h
SILENCE_INTERVAL=1h

# --- Сроки хранения. Пусто — как в программе ---
# Снимки месяц, опубликованные сообщения неделя, задания месяц. Последний
# снимок каждой машины хранится всегда.
RETENTION_SNAPSHOTS=
RETENTION_OUTBOX=
RETENTION_COMMANDS=

# --- Регистраций в минуту с одного адреса. Пусто — 600 ---
ENROLL_BURST=

# --- Наблюдение (профиль metrics, необязательно) ---
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=
