# Образ для разработки и прогонов: компилятор внутри, исходники монтируются
# томом. Правило проекта — тесты и линтеры запускаются здесь, а не локальным
# окружением, чтобы «у меня работает» означало то же самое у всех.
FROM golang:1.27-alpine

# gcc и musl-dev нужны детектору гонок: `go test -race` требует cgo. Гонки в
# службе, которая пишет из нескольких горутин, ловятся только так.
RUN apk add --no-cache git make curl gcc musl-dev

# Линтер ставится в образ, а не запускается отдельным контейнером: так его
# версия зафиксирована вместе с версией Go.
RUN go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest

WORKDIR /src

# Кеш модулей и сборки живёт в томе (см. compose), иначе каждый прогон
# начинается с полной загрузки зависимостей.
ENV GOFLAGS=-buildvcs=false
ENV CGO_ENABLED=1

CMD ["go", "run", "./cmd/server"]
