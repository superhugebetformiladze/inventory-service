{
  "uid": "inventory",
  "title": "Инвентаризация",
  "description": "Четыре вопроса, которые задают, когда что-то не так: доходят ли отчёты, уходят ли они в ленту, кто молчит и где стало медленно.",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Отчёты в минуту по исходу",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(inventory_reports_total[5m])) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Лаг ленты: возраст самого старого неопубликованного",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "inventory_outbox_lag_seconds",
          "legendFormat": "лаг",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Очередь публикации",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "inventory_outbox_pending",
          "legendFormat": "ждёт публикации",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Время приёма отчёта: медиана и 99-й процентиль",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(inventory_report_seconds_bucket[5m])) by (le))",
          "legendFormat": "медиана",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(inventory_report_seconds_bucket[5m])) by (le))",
          "legendFormat": "99-й процентиль",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Парк: всего и молчащих",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "inventory_hosts_total",
          "legendFormat": "всего",
          "refId": "A"
        },
        {
          "expr": "inventory_hosts_silent",
          "legendFormat": "молчат",
          "refId": "B"
        },
        {
          "expr": "inventory_unresolved_total",
          "legendFormat": "ждут разбора",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "Возраст самого старого отчёта по парку",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "inventory_oldest_report_seconds",
          "legendFormat": "возраст",
          "refId": "A"
        }
      ]
    }
  ]
}
