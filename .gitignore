# Ключи подписи кода.
#
# .pfx — это право подписать ЛЮБУЮ программу так, что весь парк сочтёт её
# доверенной. В репозитории ему не место ни при каких обстоятельствах; .cer
# рядом безобиден, но каталог закрывается целиком, чтобы не полагаться на
# внимательность при добавлении файлов.
/deploy/windows/подпись/ключи/
