node_modules
dist
.vite
*.log

# Фронтенд целиком на TypeScript: в src нет и не должно быть файлов .js/.jsx.
# Если такие файлы остались от прошлой версии (например, проект скопировали на сервер
# поверх старого), TypeScript подхватит их вместо новых папок и сборка упадёт.
# Поэтому в образ они не попадают вовсе.
src/**/*.js
src/**/*.jsx
src/styles.css
src/pages
vite.config.js
